# zaelar — environment (copy to ../.env, fill, never commit). Motor de voz LiveKit (INI-012) + cerebro «Colmena».
# Defaults = lo que usa el código si la var no está. Setup: README.md (raíz) + .meshkore/docs/ops/zaelar-ops.md.
#
# ⚠️ LA CONFIG SE GESTIONA DESDE LA UI (invariante de producto). El WIZARD de primer arranque (🧭, V2-040) elige el
# perfil local/cloud, detecta lo instalado y guarda las claves en el credential store (.meshkore/credentials/
# zaelar.env, chmod 600) → el store MANDA sobre este .env. Esto es el FALLBACK power-user/headless. Nombres de
# variable = los que lee el motor de verdad (config/settings.py ENV_KEYS + voice/engine/core/config.py).

# ── API keys (solo las de los proveedores que elijas) ──────────────────────────────────────────────────────
AIMLAPI_KEY=            # FlashBrain en la nube (Haiku/Grok, config/v2 §fast) + STT/LLM opcional vía router
DEEPGRAM_API_KEY=       # STT deepgram (nube)
MISTRAL_API_KEY=        # STT voxtral (Mistral, nube)
CARTESIA_API_KEY=       # TTS cartesia (multilingüe, nube)
ELEVENLABS_API_KEY=     # TTS elevenlabs (nube, fiable)
GEMINI_API_KEY=         # FlashBrain Gemini (alternativa)
OPENAI_API_KEY=         # reranker/embeddings de memoria en la nube (opcional)

# ── STT · voz→texto (registro del motor: voice/engine/speech/stt) ──────────────────────────────────────────
# OBJETIVO = gratis + LOCAL + privado: `make install-stt` (Whisper) y ZAELAR_STT=whisper_local corre 100% en el
# equipo. Proveedores REALES (los únicos que el motor conoce):
#   whisper_local = local·gratis·privado (faster-whisper / MLX en Apple Silicon)  ← el objetivo
#   voxtral       = Mistral (nube, needs MISTRAL_API_KEY)   ·   deepgram = Deepgram Nova-3 (nube, needs DEEPGRAM_API_KEY)
ZAELAR_STT=whisper_local       # whisper_local | voxtral | deepgram   (lo fija el ⚙/wizard; esto es fallback)
ZAELAR_LANGUAGE=es             # es | en (idioma del operador; STT+voz+respuestas se re-alinean juntos)
ZAELAR_WHISPER_MODEL=small     # Whisper local Win/Linux (faster-whisper): tiny|base|small|medium|large-v3|turbo
ZAELAR_WHISPER_MLX_MODEL=mlx-community/whisper-large-v3-turbo   # Whisper local Mac (Apple Silicon, MLX)
ZAELAR_STT_MODEL_DG=nova-3     # solo si fijas deepgram

# ── TTS · texto→voz (registro del motor: voice/engine/speech/tts) ──────────────────────────────────────────
# Proveedores REALES: kokoro_local = LOCAL (gratis·ilimitado·privado, Apple Silicon Metal; `make install-tts`) ·
# cartesia / elevenlabs = nube (pago; elevenlabs es el TTS cloud fiable, V2-035).
ZAELAR_TTS=kokoro_local        # kokoro_local | cartesia | elevenlabs
CARTESIA_VOICE_ID=             # solo si ZAELAR_TTS=cartesia
ELEVENLABS_VOICE_ID=           # solo si ZAELAR_TTS=elevenlabs (multilingüe; cualquiera habla ES)
ZAELAR_KOKORO_VOICE=ef_dora    # solo si ZAELAR_TTS=kokoro_local: ef_dora (f, es) | af_bella (f, en)

# ── Brain · LLM (catalog behind a thin contract) ───────────────────────────────────────────────────────────
# Hermes (BRAIN=hermes) reads its OWN model from ~/.hermes/config.yaml (model.default). Current model:
# deepseek/deepseek-v4-flash via AIMLAPI (cheap, non-reasoning; gpt-4.1 is the earlier validated example).
# CRITICAL: the voice brain MUST be a NON-REASONING model. Verified 2026-06-29: a reasoning model (GLM-4.6/GLM-5.2)
# ACP turn NEVER closes on the voice path (no stopReason:end_turn) → turns queue ("Queued for the next turn") →
# zaelar stops replying (gpt-4.1 closed the turn in ~4s, thoughtTokens 0; deepseek-v4-flash validated too).
# Do NOT put a reasoning model here until the two-speed brain (fast layer + async Hermes; see docs) is built.
# LLM_MODEL below = BRAIN=direct path only.
BRAIN=hermes                   # hermes (agent+memory+tools, recommended) | direct (bare model)
ASSISTANT_LLM_MODEL=deepseek/deepseek-v4-flash
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_BASE_URL=                  # set for any OpenAI-compatible endpoint (BRAIN=direct)
LLM_MAX_TOKENS=120
REASONING_EFFORT=
ASSISTANT_NAME=zaelar

# ── Turn-taking / audio (voice/turn_control.py) ────────────────────────────────────────────────────────────
ECHO_SUPPRESS=0                # 0 = off (browser echoCancellation handles echo; keeps STT always listening)
AUDIO_FILTER=rnnoise           # rnnoise (free, + the 16k↔48k resample STT needs) | none | krisp
BARGE_IN_MS=800                # sustained speech (ms) needed to interrupt the bot
TURN_SILENCE_SECS=0.6
SILENCE_MODE=0                 # OFF: el re-run del LLM repetía el último turno. Proactividad → cron de Hermes (Fase 3)

# ── Widget code-gen agent (widgets/generator.py → headless Claude Code) ────────────────────────────────────
# CLAUDE_BIN=                  # auto-discovered (PATH/nvm/homebrew); set to override
WIDGET_GEN_MODEL=              # optional model for the widget agent (e.g. sonnet)
WIDGET_GEN_TIMEOUT=240
WIDGETS_DATA_TIMEOUT=8         # hard timeout (s) for widget data.py hooks — a slow widget degrades, never mutes voice
WIDGETS_PROGRESS_SECS=30       # cadence of "still building…" notices during widget generation

# ── MeshKore cluster channel (connectors/meshkore/ — 3rd I/O next to voice+chat) ───────────────────────────
# Security posture: strict by default, fail-closed. Cluster peers are UNTRUSTED external agents — cluster turns
# run with Hermes tools DENIED unless you explicitly opt in. Details: .meshkore/docs/security/zaelar-security.md.
MESHKORE_WS_BASE=              # wss:// base of the cluster daemon (empty = default daemon)
MESHKORE_AGENT_HANDLE=zaelar   # our handle in the cluster
MESHKORE_DID=                  # our did:key identity (generated/managed by the connector)
MESHKORE_SECURITY=strict       # strict (default) — do not lower without reading zaelar-security.md
MESHKORE_CLUSTER_TOOLS=0       # 1 = allow Hermes tools on CLUSTER turns (dangerous; default deny)
MESHKORE_API_TOKEN=            # optional token for the REST control plane (otherwise loopback-only)
MESHKORE_ALLOW_INSECURE=0      # 1 = allow ws:// instead of wss:// (local testing only)
MESHKORE_AUTORECONNECT=1       # reconnect saved clusters on boot
MESHKORE_MAX_INFLIGHT=8        # flood cap: max concurrent inbound cluster turns
MESHKORE_MAX_TOKENS=           # optional cap for cluster-turn generation
MESHKORE_IDLE_SECS=            # heartbeat idle window (default in code)
MESHKORE_TICK_SECS=            # heartbeat tick (default in code)
MESHKORE_MISSION_MODEL=        # optional model override for the mission reasoner
MESHKORE_SECRET_TERMS=         # comma-separated extra terms the outbound scanner must redact

# ── WebRTC / TURN (prod; for reliable mobile media use Cloudflare TURN) ────────────────────────────────────
WEBRTC_HOST=
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Hermes (brain + memory). Install + `hermes setup`; persona seeds from .meshkore/docs/ops/hermes-MEMORY.seed.md ─
HERMES_HOME=~/.hermes
HERMES_CMD=hermes
HERMES_BIN=~/.local/bin/hermes

# ── Música: conector Spotify (connectors/spotify/, V2-041) ─────────────────────────────────────────────────
# CONÉCTALO DESDE LA UI (config → música): pega tu client_id de developer.spotify.com y pulsa conectar (OAuth
# PKCE, sin secreto). El client_id se guarda en el credential store; los tokens en .meshkore/credentials/
# spotify.json (chmod 600). Reproducir necesita cuenta Premium + un dispositivo Spotify activo. En el panel de
# tu app de Spotify, añade esta Redirect URI EXACTA:  http://127.0.0.1:43917/api/spotify/callback
SPOTIFY_CLIENT_ID=                     # client_id de TU app en developer.spotify.com (fallback; normal = UI)
SPOTIFY_DEFAULT_CLIENT_ID=             # client_id de la app de ZAELAR → conectar con UN CLIC (el usuario solo inicia sesión)
SPOTIFY_REDIRECT_URI=                  # opcional; def http://127.0.0.1:43917/api/spotify/callback (debe coincidir con la app)
# Música GRATIS (fallback sin Spotify): el widget `musica` reproduce el AUDIO de un vídeo de YouTube OCULTO. La
# búsqueda usa la YouTube Data API si hay key (rápida/fiable), si no un scrape stdlib (best-effort). Opcional:
YOUTUBE_API_KEY=                       # opcional: YouTube Data API v3 (búsqueda de música más fiable; si falta, scrape)

# ── Wake-word (roadmap I2.1, not wired yet) ────────────────────────────────────────────────────────────────
WAKE_WORD=zaelar
PORCUPINE_ACCESS_KEY=

# ── Architect provider (connectors/architect/) — remote control of the shared MeshKore daemon ──
ARCHITECT_URL=https://127.0.0.1:5573   # local daemon base (self-signed TLS accepted for loopback only)
ARCHITECT_TOKEN=                       # bearer token from the cockpit (Config → Remote control). NEVER commit.
ARCHITECT_PARENT=                      # default parent folder for [[architect.new]] (operator project dirs)
ARCHITECT_ASK_TIMEOUT=900              # max seconds to wait for one architect-master turn

# ── Messaging: unified triaged inbox (INI-014 WhatsApp + INI-015 Telegram) ──────────────────────────────────
# CONNECT THESE FROM THE UI, NOT HERE. zaelar's rule: install once, then manage everything from the interface —
# say "conéctame Telegram" (or open the `mensajeria` widget) and it guides you step by step (enter credentials →
# scan QR). The enable flags + Telegram credentials are stored in config/connectors.json (gitignored), written by
# the widget. The vars BELOW are only an OPTIONAL power-user fallback: config/connectors.json always wins over them,
# so on a normal install you can leave this whole block untouched.
MSG_TRIAGE_MODEL=                      # shared classifier model (blank → ZAELAR_LOCAL_LLM_MODEL, i.e. qwen2.5:3b)
MSG_TRIAGE_URL=                        # OpenAI-compatible endpoint (blank → local Ollama :11434/v1)
MSG_TRIAGE_KEY=local                   # API key for the classifier backend (Ollama ignores it; set for remote)
WA_MY_NAME=                            # your name — helps the classifier judge "addressed to me" (optional)
WA_BRIDGE_PORT=3111                    # loopback port of the vendored bridge (avoid 3000 = hermes gateway)
WA_POLL_INTERVAL=5                     # seconds between buzón polls
TG_MY_NAME=                            # your name — helps the classifier judge "addressed to me" (optional)
TG_BATCH_INTERVAL=5                    # seconds between triage passes of the incoming buffer
# WA_ENABLED / TG_ENABLED / TG_API_ID / TG_API_HASH: OMITTED ON PURPOSE — set them from the widget, not by hand.
# (If you insist on a headless power-user setup, they still work as a fallback when config/connectors.json is absent.)
