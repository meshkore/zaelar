.venv/
.env
logs/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
config/settings.json
config/meshkore.json
# connector config MANAGED FROM THE UI (INI-015): enable flags + credentials (Telegram api_id/api_hash) the user
# enters in the messaging widget. Personal secrets → NEVER commit.
config/connectors.json
config/v2.json
# Identidad de ESTA instalación (UUID4 aleatorio + fecha). Runtime por-instalación, jamás al repo:
# commitearlo haría que todo el que clone comparta user_id y la observabilidad mezclaría instalaciones.
config/identity.json
# `engine/.meshkore/` es una CARPETA REAL (2026-07-28, revierte la decisión 2026-07-24 de excluirla entera).
# engine es el repo PÚBLICO OSS y DEBE llevar su contexto MeshKore Standard — arquitectura, convenciones,
# módulos, seguridad, roadmap del MOTOR, roles de agente (team/), public/cluster.yaml y STANDARD_VERSION —
# para que quien clone diga «carga el estándar MeshKore» y tenga todo el contexto/tareas. La gestión de
# NEGOCIO/proyecto (cloud/GTM, launch-readiness…) NO vive aquí: vive en `../.meshkore/` (raíz del workspace,
# fuera de este repo). Lo único que se ignora = estado runtime PRIVADO del self-hoster, nunca al repo:
.meshkore/credentials/
.meshkore/logs/
.meshkore/timeline/
.meshkore/snapshots/
.meshkore/agents/
.meshkore/.runtime/
.meshkore/**/*.env

# voice-lab-2 is its OWN git repo (reference engine for the LiveKit migration, INI-012) — not tracked here
voice-lab-2/
# local backup of prior voice-lab experiments
.bkp/

# MeshKore module diario ("diario de actuaciones") is DOCUMENTATION, not runtime logs — must be tracked
# despite the broad `logs/` rule above (which still ignores root logs/, voice/logs/, .meshkore/logs/, …).
!.meshkore/modules/**/logs/
!.meshkore/modules/**/logs/**

# widget generator in-flight job journal (runtime, ephemeral)
widgets/_data/_jobs.json

# v2 «Colmena» — memoria central + log durable del bus: un solo fichero SQLite local (gitignored)
memory/_data/
zaelar.db
zaelar.db-wal
zaelar.db-shm

# Unified test observatory: append-only executions, voice scratch and captured artifacts.
# Curated voice history lives in tests/voice/e2e/agent/reports/ and remains versioned.
tests/runs/

# WhatsApp connector (INI-014): npm-installed deps of the vendored bridge, and the
# WhatsApp pairing session (personal credentials — NEVER commit) + triage state.
connectors/whatsapp/bridge/node_modules/
connectors/whatsapp/_session/
connectors/whatsapp/_data/
# Telegram connector (INI-015): userbot login session (personal credentials — NEVER commit).
connectors/telegram/_session/
# files/ module: flat inbox of whatever the operator pastes/drops onto the frontend — personal content, never commit.
files/uploads/
# el store del widget lleva CUERPOS de mensajes personales (triaje) → nunca al repo.
widgets/_data/whatsapp.json
widgets/_data/mensajeria.json
# Tras la restructura del store (widgets/_data/<id>/state.json): cubre la ruta por-directorio de los datos
# personales de mensajería (mensajes reales + churn en cada poll) — NUNCA se versionan.
widgets/_data/mensajeria/
widgets/_data/whatsapp/
# navegador (widget backed): estado vivo + CAPTURAS de página (shot.png, ~0.5MB) que cambian en cada navegación
# — efímero y con la navegación personal del operador; nunca al repo.
widgets/_data/navegador/
# tarea-navegador (widget backed) + cluster-registro: estado runtime (state.json) — datos, no código; nunca al repo.
widgets/_data/tarea-navegador/
widgets/_data/cluster-registro/
# Regla GENERAL (2026-07-14): los DATOS runtime de CUALQUIER widget (widgets/_data/<id>/) nunca van al repo —
# un widget nuevo no debe requerir tocar este fichero. (agenda/state.json estaba trackeado por accidente; el
# reset de memoria lo borra y eso dejaba el árbol sucio.)
widgets/_data/*/

# temporales / benchmarks efímeros (no-core)
scratchpad/

# Zaelar self-contained runtime
bin/

# Copias locales de reversión del config runtime (nunca al repo)
config/*.bak-*

# generated i18n bundles (runtime, produced by the LLM per language)
i18n/generated/

# BORRADORES DE LOS BRAIN WORKERS — nunca al repo (y menos a uno PÚBLICO).
# El worker escribe su entregable en un fichero de RUTA RELATIVA de su directorio de trabajo, que hoy es la raíz
# del engine (`dispatch`: «`informe.json` a secas, nunca /tmp ni una ruta absoluta»). Sin esto, cualquier
# `git add -A` barre el borrador del último worker: `informe.json` llegó a versionarse DOS veces (816efd7,
# 8a959b8) y la copia que quedó en HEAD era el informe de vacaciones del operador con las fechas, el presupuesto
# y las edades de sus hijos. Es un artefacto de trabajo, no fuente.
# Se ignora el PATRÓN, no los tres nombres que usó el run que destapó esto: el contrato dice «`informe.json` a
# secas» como EJEMPLO, así que el worker siguiente puede llamarlo `resultados.json` o `veleros.json` y la fuga se
# reabre. La raíz del engine no tiene ningún `.json` legítimo versionado (comprobado: cero), y el contexto ya manda
# tenerla limpia — así que cualquier `.json` suelto ahí es un borrador de worker. Si algún día hace falta uno de
# verdad, se des-ignora explícitamente con `!nombre.json`, que es una decisión visible en vez de un descuido.
/*.json
