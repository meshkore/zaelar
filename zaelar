#!/usr/bin/env bash
# Zaelar launcher (macOS / Linux). Self-contained: everything lives under this folder.
#   ./zaelar            first run: check + setup + start.  After that: start.
#   ./zaelar doctor     check requirements
#   ./zaelar setup      create local .venv and install dependencies
#   ./zaelar start      run Zaelar in the foreground (Ctrl-C quits) — http://localhost:43917
#   ./zaelar up         start it in the BACKGROUND and return your prompt
#   ./zaelar stop       stop it
#   ./zaelar restart    stop + start in the background (this is how you load changed code)
#   ./zaelar status     is it running? which build?
#   ./zaelar update     git pull + re-setup
set -euo pipefail
cd "$(dirname "$0")"

# Prefer a Python known to have wheels for every pinned dependency (some, e.g. the Apple-Silicon TTS
# phonemizer, don't yet ship builds for the newest interpreter the day it's released) — try 3.12/3.11/3.13
# first, only falling back to whatever generic python3 is on PATH.
PY=""
for c in python3.12 python3.11 python3.13 python3; do
  if command -v "$c" >/dev/null 2>&1; then PY="$(command -v "$c")"; break; fi
done
need_python() {
  if [ -z "$PY" ]; then
    echo "Zaelar needs Python 3.11+."
    case "$(uname -s)" in
      Darwin) echo "Install it with:  brew install python@3.12   (or from https://python.org/downloads)";;
      *)      echo "Install it from your package manager or https://python.org/downloads";;
    esac
    exit 1
  fi
}

doctor() { need_python; "$PY" scripts/doctor.py; }

setup() {
  need_python
  "$PY" scripts/doctor.py || { echo "Fix the requirements above and re-run ./zaelar setup"; exit 1; }
  [ -d .venv ] || { echo "Creating self-contained environment (.venv)…"; "$PY" -m venv .venv; }
  # shellcheck disable=SC1091
  . .venv/bin/activate
  python -m pip install --upgrade pip >/dev/null
  echo "Installing dependencies…"; python -m pip install -r requirements.txt
  echo "Setup complete.  Start with:  ./zaelar start"
}

start() {
  [ -d .venv ] || setup
  export PORT="${ZAELAR_PORT:-43917}"
  # `local.zaelar.com` is a PUBLIC DNS A record pointing at 127.0.0.1, so the name always means «this machine».
  # Its certificate is PER INSTALL (scripts/tls_cert.py, issued by a local mkcert CA) — nothing shared, nothing
  # in the repo. Without mkcert the engine runs on plain HTTP only; http://localhost still gets the microphone.
  export ZAELAR_TLS_CHECKED=1   # run-livekit.sh would run the same check; once is enough
  if .venv/bin/python scripts/tls_cert.py; then
    echo "Starting Zaelar → https://local.zaelar.com:44317   (plain HTTP: http://localhost:${PORT})"
  else
    echo "Starting Zaelar → http://localhost:${PORT}"
  fi
  # Delegates to the real stack: native LiveKit media server (auto-installed if missing, no Docker) +
  # the web server with the embedded voice agent (BRAIN=nucleo). Same path as `make run`.
  exec bash scripts/run-livekit.sh
}

# Background lifecycle. The logic is in scripts/zaelar.py (standard library only) so that macOS, Linux and Windows
# all run the SAME code — `zaelar.ps1` calls the same file with the same verbs. Until now you could start Zaelar but
# not stop it or ask whether it was running, which on a self-hosted install is the half you need most.
lifecycle() {
  [ -d .venv ] || setup
  exec .venv/bin/python scripts/zaelar.py "$1"
}

case "${1:-start}" in
  doctor) doctor;;
  setup)  setup;;
  start|"") start;;
  up)      lifecycle start;;
  stop)    lifecycle stop;;
  restart) lifecycle restart;;
  status)  lifecycle status;;
  update) git pull --ff-only && setup;;
  *) echo "usage: ./zaelar [doctor|setup|start|up|stop|restart|status|update]"; exit 1;;
esac
